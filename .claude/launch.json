{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "recorded-demo-viewer",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["plugins/whatran/bin/whatran.py", "--root", "examples/recorded-demo", "serve", "--port", "8787"],
      "port": 8787
    },
    {
      "name": "recorded-demo-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8792", "--directory", "examples/recorded-demo/site"],
      "port": 8792
    },
    {
      "name": "landing-page",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8790", "--directory", "pages"],
      "port": 8790
    }
  ]
}
