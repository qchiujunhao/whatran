{
  "method": {
    "title": "Tumor classification across two model paths",
    "question": "Can tumor measurements separate malignant from benign, and is that conclusion stable across a linear and a nonlinear model?"
  },
  "inputs": ["data/cancer.csv"],
  "run": "bash run.sh",
  "results_dir": "results",
  "steps": [
    {
      "id": "prepare",
      "title": "Create one seeded stratified split shared by both paths",
      "script": "steps/01_prepare.py",
      "produces": ["results/train.csv", "results/test.csv"]
    },
    {
      "id": "logistic",
      "title": "Path A: fit and evaluate standardized logistic regression",
      "script": "steps/02_logistic.py",
      "produces": [
        "results/logistic_metrics.json",
        "results/logistic_roc.json",
        "results/logistic_coefficients.json"
      ]
    },
    {
      "id": "forest",
      "title": "Path B: fit and evaluate a seeded random forest",
      "script": "steps/03_forest.py",
      "produces": [
        "results/forest_metrics.json",
        "results/forest_roc.json",
        "results/forest_importance.json"
      ]
    },
    {
      "id": "compare",
      "title": "Compare performance and assess conclusion stability",
      "script": "steps/04_compare.py",
      "produces": ["results/comparison.json"]
    },
    {
      "id": "visualize",
      "title": "Show both ROC curves and both sets of model drivers",
      "script": "steps/05_visualize.py",
      "produces": ["results/roc_comparison.svg", "results/model_drivers.svg"]
    }
  ],
  "outputs": [
    {"path": "logistic_metrics.json", "compare": "numeric", "tolerance": 1e-06},
    {"path": "logistic_roc.json", "compare": "numeric", "tolerance": 1e-06},
    {"path": "logistic_coefficients.json", "compare": "numeric", "tolerance": 1e-06},
    {"path": "forest_metrics.json", "compare": "numeric", "tolerance": 1e-06},
    {"path": "forest_roc.json", "compare": "numeric", "tolerance": 1e-06},
    {"path": "forest_importance.json", "compare": "numeric", "tolerance": 1e-06},
    {"path": "comparison.json", "compare": "numeric", "tolerance": 1e-06},
    {"path": "roc_comparison.svg", "compare": "exists"},
    {"path": "model_drivers.svg", "compare": "exists"}
  ]
}
